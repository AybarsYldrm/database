{
  "name": "@fitfak/database",
  "version": "2.0.0",
  "description": "Encrypted binary database engine for Node.js with an mTLS gRPC server and client (part of the FITFAK stack)",
  "main": "index.js",
  "type": "commonjs",
  "author": {
    "email": "network@fitfak.net",
    "name": "Aybars Yıldırım",
    "url": "https://aybars.net.tr"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "src/",
    "test/",
    "scripts/"
  ],
  "keywords": [
    "database",
    "encrypted",
    "binary",
    "grpc",
    "mtls",
    "dns",
    "secrets",
    "zero-dependency"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:basic": "node test/basic-usage.js",
    "test:direct": "node test/direct-access-demo.js",
    "test:mls": "node test/mls-key-provider-demo.js",
    "test:crypto-offload": "node test/crypto-offload-demo.js",
    "test:index-snapshot": "node test/index-snapshot-demo.js",
    "test:range-query": "node test/range-query-demo.js",
    "test:disk-backed-index": "node test/disk-backed-index-demo.js",
    "test:object-store": "node test/object-store-demo.js",
    "test:object-direct": "node test/object-store-direct-access-demo.js",
    "test:grpc": "node test/grpc-bootstrap-demo.js",
    "test:secrets-dns": "node test/secret-and-dns-demo.js",
    "test:adapter-compat": "node test/adapter-compat-demo.js",
    "test:engine": "npm run test:basic && npm run test:direct && npm run test:mls && npm run test:crypto-offload && npm run test:index-snapshot && npm run test:range-query && npm run test:disk-backed-index && npm run test:object-store && npm run test:object-direct && npm run test:schema",
    "test": "npm run test:engine && npm run test:secrets-dns && npm run test:grpc && npm run test:adapter-compat",
    "example:idp": "node examples/idp-bootstrap.js",
    "link:grpc": "node scripts/link-grpc.js",
    "test:schema": "node test/schema-migration-demo.js"
  },
  "dependencies": {
    "@fitfak/grpc": "^2.0.0"
  },
  "peerDependencies": {
    "@fitfak/ssl": "*"
  },
  "peerDependenciesMeta": {
    "@fitfak/ssl": {
      "optional": true
    }
  }
}
